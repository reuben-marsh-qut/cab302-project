<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.ProgressController"
            styleClass="page-body">

    <stylesheets>
        <URL value="@../../../stylesheets/home.css"/>
        <URL value="@../../../stylesheets/progress.css"/>
    </stylesheets>

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <left>
        <fx:include source="sidebar-view.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>
                <VBox spacing="24"
                      minWidth="0">

                    <padding>
                        <Insets top="18"
                                right="20"
                                bottom="50"
                                left="36"/>
                    </padding>

                    <VBox spacing="6">
                        <Label text="Progress"
                               styleClass="page-header"/>

                        <Label text="See how your completed activities add up over time."
                               wrapText="true"
                               styleClass="page-subheader"/>
                    </VBox>

                    <VBox spacing="16"
                          minWidth="0"
                          styleClass="card">

                        <Label text="Choose your period"
                               styleClass="section-title"/>

                        <FlowPane hgap="16"
                                  vgap="12"
                                  alignment="BOTTOM_LEFT">

                            <VBox spacing="6">
                                <Label text="From"
                                       labelFor="$fromDatePicker"/>

                                <DatePicker fx:id="fromDatePicker"
                                            prefWidth="170"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="To"
                                       labelFor="$toDatePicker"/>

                                <DatePicker fx:id="toDatePicker"
                                            prefWidth="170"/>
                            </VBox>

                            <Button text="Update report"
                                    onAction="#onRefreshButtonClick"
                                    styleClass="primary-button"/>
                        </FlowPane>

                        <Label text="Both dates are included. Choose up to 366 days."
                               wrapText="true"
                               styleClass="section-description"/>
                    </VBox>

                    <VBox spacing="16"
                          minWidth="0"
                          styleClass="card">

                        <Label text="Daily completions"
                               styleClass="section-title"/>

                        <Label fx:id="summaryLabel"
                               wrapText="true"
                               styleClass="section-description"/>

                        <Label fx:id="statusLabel"
                               wrapText="true"
                               visible="false"
                               managed="false"
                               styleClass="section-description"/>

                        <ScrollPane fx:id="chartScrollPane"
                                    fitToWidth="false"
                                    fitToHeight="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    minWidth="0"
                                    minHeight="365"
                                    prefHeight="365"
                                    maxHeight="365"
                                    styleClass="progress-chart-scroll">

                            <content>
                                <BarChart fx:id="completionChart"
                                          animated="false"
                                          legendVisible="false"
                                          horizontalGridLinesVisible="true"
                                          verticalGridLinesVisible="false"
                                          alternativeRowFillVisible="false"
                                          alternativeColumnFillVisible="false"
                                          minWidth="320"
                                          prefWidth="600"
                                          minHeight="340"
                                          prefHeight="340"
                                          maxHeight="340"
                                          categoryGap="5"
                                          barGap="0"
                                          styleClass="progress-chart">

                                    <xAxis>
                                        <CategoryAxis fx:id="completionDateAxis"
                                                      label="Completion date"
                                                      side="BOTTOM"
                                                      animated="false"
                                                      tickLabelsVisible="true"
                                                      tickMarkVisible="true"
                                                      tickLabelRotation="-55"
                                                      minHeight="80"
                                                      prefHeight="80"/>
                                    </xAxis>

                                    <yAxis>
                                        <NumberAxis fx:id="completionAxis"
                                                    label="Completed activities"
                                                    side="LEFT"
                                                    animated="false"
                                                    autoRanging="false"
                                                    lowerBound="0"
                                                    upperBound="1"
                                                    tickUnit="1"
                                                    tickLabelsVisible="true"
                                                    tickMarkVisible="true"
                                                    minorTickVisible="false"
                                                    forceZeroInRange="true"
                                                    minWidth="65"
                                                    prefWidth="65"/>
                                    </yAxis>

                                </BarChart>
                            </content>
                        </ScrollPane>

                        <Label fx:id="undatedLabel"
                               wrapText="true"
                               visible="false"
                               managed="false"
                               styleClass="section-description"/>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>