<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.ActivityController"
            prefHeight="412.0" prefWidth="732.0"
            stylesheets="@../../../stylesheets/home.css"
            fx:id="rootPane">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <left>
        <fx:include source="sidebar-view.fxml"/>
    </left>

    <center>
        <BorderPane fx:id="contentPane">
            <center>
                <ScrollPane fitToHeight="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true">

                    <VBox spacing="15">

                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>

                        <fx:include source="nav-bar-view.fxml"/>

                        <Label styleClass="page-header">Activities</Label>
                        <Label styleClass="page-subheader">Contribute to your own Activity!</Label>

                        <!-- Opens the activity creation dialog (US-06)-->
                        <Button text="New Activity" prefHeight="40" prefWidth="120" onAction="#onNewActivity"/>

                        <Separator/>

                        <!--            Activities container-->
                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                    minHeight="270" prefHeight="270" maxHeight="270">
                            <content>
                                <HBox fx:id="incompleteActivitiesContainer" spacing="20"/>
                            </content>
                        </ScrollPane>

                        <Label styleClass="page-header">Completed Activities</Label>
                        <Label styleClass="page-subheader">Reflect on your past activities</Label>

                        <Separator/>

                        <!--                Completed activities container-->
                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                    minHeight="270" prefHeight="270" maxHeight="270">
                            <content>
                                <HBox fx:id="completeActivitiesContainer" spacing="20"/>
                            </content>
                        </ScrollPane>


                    </VBox>
                </ScrollPane>
            </center>

        </BorderPane>
    </center>


</BorderPane>
