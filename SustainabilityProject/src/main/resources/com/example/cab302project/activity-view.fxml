<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.ActivityController"
            fx:id="rootPane"
            stylesheets="@../../../stylesheets/home.css"
            styleClass="page-body">

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <left>
        <fx:include source="sidebar-view.fxml"/>
    </left>

    <center>

        <!--
            Changing Activity View to Match Goal View
        -->
        <BorderPane fx:id="contentPane">

            <center>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED">

                    <VBox spacing="26">

                        <padding>
                            <Insets top="18"
                                    right="20"
                                    bottom="50"
                                    left="48"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="6"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Activities"
                                       styleClass="page-header"/>

                                <Label text="Allocate useful activities to grow yourself."
                                       styleClass="page-subheader"/>

                            </VBox>

                            <Button text="New Activity"
                                    prefWidth="130"
                                    onAction="#onNewActivity"
                                    styleClass="primary-button"/>

                        </HBox>

                        <VBox spacing="18"
                              styleClass="card">

                            <Label text="Current activities"
                                   styleClass="section-title"/>

                            <Label text="The standalone activities you're actively working towards."
                                   styleClass="section-description"/>

                            <ScrollPane fitToHeight="true"
                                        hbarPolicy="AS_NEEDED"
                                        vbarPolicy="NEVER"
                                        minHeight="270"
                                        prefHeight="270"
                                        maxHeight="270">

                                <content>
                                    <HBox fx:id="incompleteActivitiesContainer"
                                          spacing="20"/>
                                </content>

                            </ScrollPane>

                        </VBox>

                        <VBox spacing="18"
                              styleClass="card">

                            <Label text="Completed activities"
                                   styleClass="section-title"/>

                            <Label text="Be proud of past completions."
                                   styleClass="section-description"/>

                            <ScrollPane fitToHeight="true"
                                        hbarPolicy="AS_NEEDED"
                                        vbarPolicy="NEVER"
                                        minHeight="270"
                                        prefHeight="270"
                                        maxHeight="270">

                                <content>
                                    <HBox fx:id="completeActivitiesContainer"
                                          spacing="20"/>
                                </content>

                            </ScrollPane>

                        </VBox>

                    </VBox>

                </ScrollPane>

            </center>

        </BorderPane>

    </center>

</BorderPane>