<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.HomeController"
            fx:id="rootPane"
            stylesheets="@../../../stylesheets/home.css"
            styleClass="page-body">

<padding>
    <Insets top="28" right="28" bottom="28" left="28"/>
</padding>

<left>
    <fx:include source="sidebar-view.fxml"/>
</left>

<center>

    <BorderPane fx:id="contentPane">

        <center>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED">

                <VBox spacing="26">

                    <padding>
                        <Insets top="18"
                                right="20"
                                bottom="50"
                                left="48"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Home"
                                   styleClass="page-header"/>

                            <Label text="Time to grow"
                                   styleClass="page-subheader"/>

                        </VBox>

                    </HBox>

                    <VBox spacing="18"
                          styleClass="card">

                        <Label text="Current goals"
                               styleClass="section-title"/>

                        <Label text="The goals you're actively working towards."
                               styleClass="section-description"/>

                        <ScrollPane fitToHeight="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    minHeight="270"
                                    prefHeight="270"
                                    maxHeight="270">

                            <content>
                                <HBox fx:id="incompleteGoalsContainer"
                                      spacing="20"/>
                            </content>

                        </ScrollPane>

                    </VBox>

                    <VBox spacing="18"
                          styleClass="card">

                        <Label text="Current activities"
                               styleClass="section-title"/>

                        <Label text="The standalone activities you're actively working towards."
                               styleClass="section-description"/>

                        <ScrollPane fitToHeight="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    minHeight="270"
                                    prefHeight="270"
                                    maxHeight="270">

                            <content>
                                <HBox fx:id="incompleteActivitiesContainer"
                                      spacing="20"/>
                            </content>

                        </ScrollPane>

                    </VBox>

                    <HBox alignment="CENTER" spacing="100">

                        <Button fx:id="goalsButton"
                                text="Explore your goals"
                                prefWidth="400"
                                onAction="#onGoalsButtonClick"
                                styleClass="primary-button"/>

                        <Button fx:id="activitiesButton"
                                text="Explore your activities"
                                prefWidth="400"
                                onAction="#onActivitiesButtonClick"
                                styleClass="primary-button"/>

                    </HBox>

                </VBox>

            </ScrollPane>

        </center>

    </BorderPane>

</center>

</BorderPane>