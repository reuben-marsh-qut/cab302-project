<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.HomeController"
            prefHeight="412.0" prefWidth="732.0"
            stylesheets="@../../../stylesheets/home.css">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <left>
        <VBox prefWidth="250" alignment="TOP_CENTER">
            <ImageView fitHeight="70" fitWidth="70" preserveRatio="true">
                <Image url="@../../../assets/logo.png"/>
            </ImageView>

            <Separator prefHeight="50"/>

            <VBox spacing="20">
                <!--                TODO: Create handlers for page navigation-->
                <Button text="Home" maxWidth="Infinity" prefHeight="50"/>
                <Button text="Your Page" maxWidth="Infinity" prefHeight="50"/>
                <Button text="Settings" maxWidth="Infinity" prefHeight="50"/>
            </VBox>

            <Separator prefHeight="50"/>

            <Region VBox.vgrow="ALWAYS"/>
            <!--            TODO: Create a handler for sign out-->
            <Button text="Sign Out" maxWidth="Infinity" prefHeight="50"/>
        </VBox>
    </left>

