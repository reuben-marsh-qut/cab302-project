                <Button text="Goals" maxWidth="Infinity" prefHeight="40" prefWidth="100"/>
                <Button text="Social" maxWidth="Infinity" prefHeight="40" prefWidth="100"/>
                <Button text="Stats" maxWidth="Infinity" prefHeight="40" prefWidth="100"/>
            </HBox>
            <Label styleClass="page-header">Goals</Label>
            <Label styleClass="page-subheader">Contribute to your own Goal!</Label>

            <!-- Opens the goal creation dialog (US-06)-->
            <Button text="New Goal" prefHeight="40" prefWidth="120" onAction="#onNewGoal"/>

            <Separator/>

            <!--            Goals container-->
            <HBox fx:id="goalsContainer" spacing="20">
<!--                <VBox styleClass="item-card" spacing="10" prefHeight="250" prefWidth="250">-->
