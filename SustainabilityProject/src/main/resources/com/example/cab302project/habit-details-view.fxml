<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cab302project.controller.HabitDetailsController"
      prefHeight="400.0" prefWidth="600.0" spacing="20">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="habitNameLabel" styleClass="page-header"/>

    <Text fx:id="categoryText"/>
    <Text fx:id="goalText"/>
    <Text fx:id="habitStreakText"/>
    <Text fx:id="startDateText"/>
    <Text fx:id="endDateText"/>

    <HBox spacing="100" fx:id="completeHabitActivityButtons">
        <VBox spacing="20">
            <TextArea fx:id="completionLog" editable="false" wrapText="true"/>
        </VBox>

    </HBox>

    <Separator/>

    <Label styleClass="page-subheader" text="Delete your habit"/>
    <Button styleClass="delete-button" mnemonicParsing="false" onAction="#onDelete" prefHeight="40.0" prefWidth="200.0" text="Delete this Habit"/>

    <Separator/>

    <Region VBox.vgrow="ALWAYS"/>

    <Button mnemonicParsing="false" onAction="#onBack" prefHeight="40.0" prefWidth="120.0" text="Back"/>

</VBox>
