<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cab302project.controller.RegisterController"
      stylesheets="@../../../stylesheets/login.css"
      spacing="28"
      alignment="CENTER"
      styleClass="login-root">

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <VBox styleClass="login-panel"
          prefWidth="430"
          minWidth="430"
          maxWidth="430"
          alignment="TOP_LEFT">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
                <Image url="@../../../assets/logo.png"/>
            </ImageView>
            <VBox spacing="-3">
                <Label text="Rooted" styleClass="brand-title"/>
                <Label text="Water your mind" styleClass="brand-tagline"/>
            </VBox>
        </HBox>

        <Region prefHeight="30"/>

        <Label text="Create your account" styleClass="login-title"/>
        <Label text="Start growing with Rooted." styleClass="login-subtitle"/>

        <Region prefHeight="20"/>

        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"
                   promptText="you@example.com"
                   maxWidth="Infinity"
                   styleClass="login-field"/>

        <Region prefHeight="10"/>

        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter your password"
                       maxWidth="Infinity"
                       styleClass="login-field"/>

        <Region prefHeight="10"/>

        <Label text="Confirm password" styleClass="field-label"/>
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm your password"
                       maxWidth="Infinity"
                       styleClass="login-field"/>

        <Region prefHeight="10"/>

        <Label text="Postcode" styleClass="field-label"/>
        <TextField fx:id="postcodeField"
                   promptText="4000"
                   maxWidth="Infinity"
                   styleClass="login-field"/>

        <Label fx:id="errorLabel"
               visible="false"
               managed="false"
               wrapText="true"
               maxWidth="Infinity"
               styleClass="error-label">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Label>

        <Button text="Create Account"
                onAction="#handleRegister"
                defaultButton="true"
                maxWidth="Infinity"
                styleClass="primary-button">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="4">
            <VBox.margin>
                <Insets top="24"/>
            </VBox.margin>
            <Label text="Already have an account?" styleClass="signup-label"/>
            <Button text="Log in" onAction="#handleLogin" styleClass="link-button"/>
        </HBox>

    </VBox>

    <StackPane styleClass="hero-panel" HBox.hgrow="ALWAYS">
        <VBox alignment="BOTTOM_LEFT" mouseTransparent="true">
            <padding>
                <Insets top="40" right="40" bottom="42" left="42"/>
            </padding>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Grow at your own pace." styleClass="hero-title"/>
            <Label text="Build habits, reach goals, and make progress that lasts."
                   styleClass="hero-subtitle"
                   wrapText="true"
                   maxWidth="500"/>
        </VBox>
    </StackPane>

</HBox>
