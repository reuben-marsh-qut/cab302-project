                    <Separator/>

                    <!--            Goals container-->
                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                minHeight="270" prefHeight="270" maxHeight="270">
                        <content>
                            <HBox fx:id="goalsContainer" spacing="20">
                                <!--                <VBox styleClass="item-card" spacing="10" prefHeight="250" prefWidth="250">-->
                                <!--                    <padding>-->
                                <!--                        <Insets left="10.0" right="10.0" top="10.0"/>-->
                                <!--                    </padding>-->
                                <!--                    &lt;!&ndash;                    TODO: Implement handlers for all of these fields&ndash;&gt;-->
                                <!--                    <Label fx:id="goalCategory" styleClass="item-category" text="Body"/>-->
                                <!--                    <Label fx:id="goalTitle" styleClass="item-header" wrapText="true" text="Run a 10 kilometre race"/>-->
                                <!--                    <Label fx:id="goalProgress" styleClass="item-details">Progress: 7.5km/10km</Label>-->
                                <!--                    <Label fx:id="goalEndDate" styleClass="item-details">End Date: 17/09/2026</Label>-->

                                <!--                    <Region VBox.vgrow="ALWAYS"/>-->

                                <!--                    <ImageView fitHeight="70" fitWidth="70" preserveRatio="true">-->
                                <!--                        <Image url="@../../../assets/plantPot.png"/>-->
                                <!--                    </ImageView>-->
                                <!--                </VBox>-->
                            </HBox>
                        </content>
                    </ScrollPane>

            <Label styleClass="page-header">Completed Goals</Label>
