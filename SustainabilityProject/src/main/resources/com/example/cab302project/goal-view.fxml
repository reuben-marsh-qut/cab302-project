<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.controller.GoalController"
            prefHeight="412.0" prefWidth="732.0"
            stylesheets="@../../../stylesheets/home.css"
            fx:id="rootPane">
<padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
</padding>

<left>
    <fx:include source="sidebar-view.fxml"/>
</left>

<center>
    <BorderPane fx:id="contentPane">
        <center>
            <ScrollPane fitToHeight="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" fitToWidth="true">

            <VBox spacing="15">

                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                
                <fx:include source="nav-bar-view.fxml"/>

                <Label styleClass="page-header">Goals</Label>
                <Label styleClass="page-subheader">Contribute to your own Goal!</Label>

                <!-- Opens the goal creation dialog (US-06)-->
                <Button text="New Goal" prefHeight="40" prefWidth="120" onAction="#onNewGoal"/>

                <Separator/>

                <!--            Goals container-->
                <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                            minHeight="270" prefHeight="270" maxHeight="270">
                    <content>
                        <HBox fx:id="incompleteGoalsContainer" spacing="20"/>
                    </content>
                </ScrollPane>

                <Label styleClass="page-header">Completed Goals</Label>
                <Label styleClass="page-subheader">Reflect on your past goals</Label>

                <Separator/>

                <!--                Completed goals container-->
                <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                            minHeight="270" prefHeight="270" maxHeight="270">
                    <content>
                        <HBox fx:id="completeGoalsContainer" spacing="20"/>
                    </content>
                </ScrollPane>


            </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
</center>


</BorderPane>