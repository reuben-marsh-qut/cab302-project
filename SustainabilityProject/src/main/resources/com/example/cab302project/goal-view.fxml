                        <content>
                            <HBox spacing="20">
                                <VBox styleClass="item-card" spacing="10" prefHeight="250" prefWidth="250">
                                    <padding>
                                        <Insets left="10.0" right="10.0" top="10.0"/>
                                    </padding>
                                    <!--                    TODO: Implement handlers for all of these fields-->
                                    <Label styleClass="item-category">Body</Label>
                                    <Label styleClass="item-header" wrapText="true">Run 10 kilometres each week</Label>
                                    <Label styleClass="item-details">Progress: 3km/10km</Label>
